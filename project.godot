; Engine configuration file.
config_version=5

[application]

config/name="Chess Tower Defense"
config/description="Minimal vector-graphics tower defense PoC with chess-piece towers."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")

[display]

window/size/viewport_width=760
window/size/viewport_height=704
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.12, 0.14, 1)
